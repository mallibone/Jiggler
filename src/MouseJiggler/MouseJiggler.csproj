<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

    <!-- App identity (App Store) -->
    <ApplicationTitle>Mouse Jiggler</ApplicationTitle>
    <ApplicationId>com.idip-solution.mousejiggler</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <!--
    Local debug: sign with a stable Apple Development identity so the macOS
    Accessibility (post-events) grant survives rebuilds. Ad-hoc signing changes the
    binary hash every build and silently revokes the grant. No sandbox here, so no
    provisioning profile is needed to run locally.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Replace with your own Apple Development identity: run `security find-identity -v -p codesigning` -->
    <CodesignKey>Apple Development: Your Name (TEAMID)</CodesignKey>
  </PropertyGroup>

  <!-- DevFlow in-app agent for inspection/automation. Debug-only — never shipped. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.11.26317.2" />
  </ItemGroup>

  <!--
    Release / App Store: sandboxed (required for the store) and optimized.
    - RunAOTCompilation: Mono AOT (the .NET-for-macOS runtime is Mono). This is the
      supported AOT here. NativeAOT (PublishAot) is NOT supported for net*-macos / the
      maui-labs AppKit backend (it targets iOS & Mac Catalyst only), and a "single
      executable" doesn't apply — a macOS app ships as a signed .app bundle.
    - Trimming (ILLink) is already enabled by default for macOS Release builds.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CodesignEntitlements>Platforms/MacOS/Entitlements.plist</CodesignEntitlements>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auto-converted to AppIcon.icns at build time (sips + iconutil). -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" />

    <!-- Extra Info.plist keys (category, copyright) merged into the generated manifest. -->
    <PartialAppManifest Include="Platforms\MacOS\PartialInfo.plist" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.11.26317.2" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.11.26317.2" />
  </ItemGroup>

</Project>
